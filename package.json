{
  "name": "ktu-e-market",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "build": "npm run build -w frontend",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev --prefix backend\" \"node ./scripts/wait-for-api.mjs && npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev --prefix backend",
    "check:env": "node ./scripts/check-env-alignment.mjs",
    "lint": "npm run lint -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
