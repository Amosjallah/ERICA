# Root ignores for KTU E-MARKET monorepo

**/node_modules/

# Secrets — never commit (examples stay tracked via negation in package dirs if needed)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Backend
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

.DS_Store
