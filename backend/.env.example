PORT=5000
# PostgreSQL — use Supabase: Project Settings → Database → Connection string (URI), mode "Transaction" or "Session"
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Optional: direct connection for migrations when using Supabase pooler (port 5432). Often same host with ?sslmode=require
# DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Comma-separated for multiple frontends (e.g. Vercel + local). CORS allows these + localhost:3000.
# CLIENT_URL=http://localhost:3000,https://your-app.vercel.app
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PLATFORM_COMMISSION_PERCENT=10
UPLOAD_DIR=./uploads
