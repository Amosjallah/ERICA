# Copy to backend/.env. Values here override shell/IDE env (see src/load-env.js).
PORT=5000
# If 5000 is in use, pick another port and set frontend NEXT_PUBLIC_API_URL (e.g. http://localhost:5001/api).
# Supabase → Project Settings → API — use "Project URL" exactly (https://xxxxx.supabase.co). Do NOT append /rest/v1.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Comma-separated for multiple frontends (e.g. Vercel + local). CORS allows these + localhost:3000.
# CLIENT_URL=http://localhost:3000,https://your-app.vercel.app
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PLATFORM_COMMISSION_PERCENT=10
UPLOAD_DIR=./uploads
