generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  vendor
  admin
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentProvider {
  stripe
  paystack
  manual
}

enum SubOrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum DiscountType {
  percent
  fixed
}

enum NotificationType {
  order
  vendor
  system
  message
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(customer)
  avatar    String   @default("")
  phone     String   @default("")
  addressLine1 String?
  addressLine2 String?
  city      String?
  state     String?
  postalCode String?
  country   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor           Vendor?
  cart             Cart?
  wishlist         Wishlist?
  orders           Order[]
  reviews          Review[]
  notifications    Notification[]
  messagesSent     Message[]       @relation("SentMessages")
  messagesReceived Message[]       @relation("ReceivedMessages")
}

model Vendor {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName                String
  slug                     String           @unique
  description              String           @default("")
  logo                     String           @default("")
  banner                   String           @default("")
  approvalStatus           ApprovalStatus   @default(pending)
  rejectionReason          String           @default("")
  approvedAt               DateTime?
  commissionOverridePercent Float?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  products       Product[]
  orderSuborders OrderSuborder[]
  messages       Message[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String     @default("")
  image       String     @default("")
  parentId    String?
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]
}

model Product {
  id              String   @id @default(cuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  title           String
  slug            String
  description     String   @default("")
  price           Float
  compareAtPrice  Float?
  images          String[] @default([])
  stock           Int      @default(0)
  sku             String   @default("")
  featured        Boolean  @default(false)
  active          Boolean  @default(true)
  averageRating   Float    @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews        Review[]
  cartItems      CartItem[]
  wishlistLinks  WishlistProduct[]
  orderLineItems OrderLineItem[]

  @@unique([vendorId, slug])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, productId])
}

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  status           OrderStatus     @default(pending_payment)
  paymentProvider  PaymentProvider @default(stripe)
  paymentIntentId  String          @default("")
  stripeSessionId  String          @default("")
  subtotal         Float
  discountTotal    Float           @default(0)
  taxTotal         Float           @default(0)
  shippingTotal    Float           @default(0)
  total            Float
  currency         String          @default("usd")
  couponCode       String          @default("")
  shippingName     String?
  shippingLine1    String?
  shippingLine2    String?
  shippingCity     String?
  shippingState    String?
  shippingPostalCode String?
  shippingCountry  String?
  shippingPhone    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  suborders OrderSuborder[]
}

model OrderSuborder {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor         @relation(fields: [vendorId], references: [id])
  subtotal          Float
  commissionTotal   Float
  vendorPayoutTotal Float
  status            SubOrderStatus @default(pending)
  lines             OrderLineItem[]
}

model OrderLineItem {
  id                 String        @id @default(cuid())
  suborderId         String
  suborder           OrderSuborder @relation(fields: [suborderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product       @relation(fields: [productId], references: [id])
  vendorId           String
  title              String
  image              String        @default("")
  unitPrice          Float
  quantity           Int
  lineTotal          Float
  commissionPercent  Float
  commissionAmount   Float
  vendorPayout       Float
}

model Wishlist {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  WishlistProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model WishlistProduct {
  wishlistId String
  productId  String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String       @default("")
  discountType   DiscountType
  discountValue  Float
  maxUses        Int?
  usesCount      Int          @default(0)
  minOrderAmount Float        @default(0)
  expiresAt      DateTime?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String             @default("")
  type      NotificationType   @default(system)
  read      Boolean            @default(false)
  meta      Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  sender         User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId    String
  recipient      User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  body           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
